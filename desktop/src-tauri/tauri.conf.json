{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Reset Radar",
  "version": "0.1.1",
  "identifier": "dev.lucky.codex-reset-radar",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codex Reset Radar",
        "width": 1200,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
