{
  "name": "codex-reset-radar",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Monitor @thsottiaux for Codex rate-limit reset announcements",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.js",
    "poll": "node --disable-warning=ExperimentalWarning src/main.js --once",
    "simulate": "node src/simulate.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "app": "pnpm -C desktop tauri dev",
    "app:build": "pnpm -C desktop tauri build"
  }
}
